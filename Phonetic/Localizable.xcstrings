    "Oldest history is removed automatically when space is needed. Your contacts are not changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oldest history is removed automatically when space is needed. Your contacts are not changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间不足时会自动清理最旧的历史记录，联系人不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間不足時會自動清理最舊的歷史記錄，聯絡人不會改變。"
          }
        }
