    "This clears phonetic fields for Chinese names and empties the fields listed below, including any content you entered manually. Contacts in your whitelist will be skipped. You can review and restore recorded changes while they remain in Version History on this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears phonetic fields for Chinese names and empties the fields listed below, including any content you entered manually. Contacts in your whitelist will be skipped. You can review and restore recorded changes while they remain in Version History on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除中文姓名对应的拼音字段，并清空下列字段，包括你手动填写的内容。白名单中的联系人会被跳过。可在本设备仍保留的版本历史中预览并恢复已记录的修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除中文姓名對應的拼音欄位，並清空下列欄位，包括你手動填寫的內容。白名單中的聯絡人會被略過。可在本裝置仍保留的版本歷史中預覽並還原已記錄的修改。"
          }
        }
      }
    },
    "This clears phonetic fields for Chinese names. Contacts in your whitelist will be skipped. You can review and restore recorded changes while they remain in Version History on this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears phonetic fields for Chinese names. Contacts in your whitelist will be skipped. You can review and restore recorded changes while they remain in Version History on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除中文姓名对应的拼音字段，白名单中的联系人会被跳过。可在本设备仍保留的版本历史中预览并恢复已记录的修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除中文姓名對應的拼音欄位，白名單中的聯絡人會被略過。可在本裝置仍保留的版本歷史中預覽並還原已記錄的修改。"
          }
        }
      }
    },
    "This only clears the whitelist. Your contacts won't be deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only clears the whitelist. Your contacts won't be deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅清空白名单，不会删除通讯录中的联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅清空白名單，不會刪除通訊錄中的聯絡人。"
          }
        }
      }
    },
    "This selects the common fields below. Their contents, including entries you added manually, will be erased when you clear contact fields. Social profiles and instant messaging accounts are selected separately." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This selects the common fields below. Their contents, including entries you added manually, will be erased when you clear contact fields. Social profiles and instant messaging accounts are selected separately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会选中下方的常用字段。执行清除操作时，这些字段的内容会被清空，包括你手动填写的内容。社交资料和即时通讯账号需要单独选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會選取下方的常用欄位。執行清除操作時，這些欄位的內容會被清空，包括你手動填寫的內容。社群個人檔案和即時通訊帳號需另外選取。"
          }
        }
      }
