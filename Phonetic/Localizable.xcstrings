          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加拼音或清除字段时，Phonetic 会跳过白名单中的联系人。\n\n轻点星标可将联系人加入或移出白名单。轻点联系人可手动编辑其字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
